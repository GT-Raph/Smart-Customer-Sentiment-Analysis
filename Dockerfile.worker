FROM python:3.10-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY api_server/requirements-worker.txt /app/api_server/requirements-worker.txt
RUN pip install --no-cache-dir -r /app/api_server/requirements-worker.txt
COPY api_server /app/api_server
CMD ["python", "-m", "api_server.worker_main"]
