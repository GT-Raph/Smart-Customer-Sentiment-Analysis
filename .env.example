# Shared XAMPP MySQL/MariaDB database.
DATABASE_ENGINE=mysql
MYSQL_DATABASE=smart_sentiment
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DB_CONN_MAX_AGE=0

# Some XAMPP releases bundle the end-of-life MariaDB 10.4 series, while Django
# 5.2 officially supports MariaDB 10.5+. Set this only for such an XAMPP bundle.
XAMPP_ALLOW_MARIADB_10_4=true
REDIS_URL=redis://localhost:6379/0

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Keep UTC unless named time-zone tables have been loaded into XAMPP MariaDB.
# UTC is also the civil time used in Ghana, so this does not shift Accra times.
DJANGO_TIME_ZONE=UTC
DJANGO_SECURE_SSL_REDIRECT=false

# API / worker
CAPTURED_FACES_DIR=private_uploads
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=16000000
RATE_LIMIT_PER_MINUTE=30
JOB_TIMEOUT_SECONDS=300
ENABLE_DEV_IMAGE_ENDPOINT=false
ENABLE_FACE_IDENTIFICATION=false
MATCH_THRESHOLD=0.45
EMBEDDING_MODEL=ArcFace
DELETE_RAW_IMAGE_AFTER_PROCESSING=true

# Desktop client (set DEVICE_API_KEY after create_device_key)
INGESTION_API_URL=http://localhost:8001/v1/snapshots
DEVICE_API_KEY=
CAPTURE_INTERVAL_SECONDS=10
CAMERA_BUSY_RETRY_SECONDS=15
CAMERA_WARMUP_FRAMES=3
SHIFT_END_HOUR=17
RESUME_WARNING_SECONDS=300
