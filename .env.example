# Main branch: hosted multi-bank SaaS. Copy this file to .env.
# Use the Session pooler values from Supabase Dashboard > Connect.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TIME_ZONE=Africa/Accra
DJANGO_SECURE_SSL_REDIRECT=False

# Supabase PostgreSQL
# The separate fields safely support passwords containing URL punctuation.
DB_ENGINE=postgresql
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=replace-with-your-database-password
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Face analysis and private image storage
EMBEDDING_MODEL=ArcFace
MATCH_THRESHOLD=0.45
MAX_UPLOAD_BYTES=5242880
MAX_EMBEDDING_CANDIDATES=5000
FACE_PROCESSING_CAPACITY_WAIT_SECONDS=2
CAPTURED_FACES_ROOT=captured_faces

# Teller camera client
FACE_API_URL=http://127.0.0.1:8001/upload-face
BANK_CODE=YOUR_BANK_CODE
BANK_API_KEY=replace-with-the-bank-upload-key
CAPTURE_INTERVAL_SECONDS=5
MAX_CONSECUTIVE_READ_FAILURES=30
MAX_DARK_PIXEL_FRACTION=0.58
MAX_BRIGHT_PIXEL_FRACTION=0.38
REJECTED_CAPTURE_RETENTION_SECONDS=86400
