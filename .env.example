# Shared PostgreSQL database. Rotate any credentials that were previously committed.
POSTGRES_DB=sentiment
POSTGRES_USER=sentiment
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL is an optional alternative for managed databases. Percent-encode
# reserved characters in its username/password when you use it.
# DATABASE_URL=postgresql://sentiment:encoded-password@localhost:5432/sentiment
REDIS_URL=redis://localhost:6379/0

# Django
DJANGO_DEBUG=true
DJANGO_USE_SQLITE=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=Africa/Accra
DJANGO_SECURE_SSL_REDIRECT=false

# API / worker
CAPTURED_FACES_DIR=private_uploads
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=16000000
RATE_LIMIT_PER_MINUTE=30
JOB_TIMEOUT_SECONDS=300
ENABLE_DEV_IMAGE_ENDPOINT=false
ENABLE_FACE_IDENTIFICATION=false
MATCH_THRESHOLD=0.45
EMBEDDING_MODEL=ArcFace
DELETE_RAW_IMAGE_AFTER_PROCESSING=true

# Desktop client (set DEVICE_API_KEY after create_device_key)
INGESTION_API_URL=http://localhost:8001/v1/snapshots
DEVICE_API_KEY=
MIN_SECONDS_BETWEEN_UPLOADS=10
