# Main branch: hosted SaaS database. Copy this file to .env.
# Use the Session pooler URL from Supabase Dashboard > Connect for a persistent
# Django/API deployment. Keep sslmode=require and URL-encode password symbols.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Instead of SUPABASE_DB_URL, you may remove it and use these separate values.
# This form is safest when the password contains @, :, /, #, ?, or %.
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.PROJECT_REF
# SUPABASE_DB_PASSWORD=replace-with-your-database-password
# SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_SSLMODE=require
DB_CONN_MAX_AGE=60
REDIS_URL=redis://localhost:6379/0

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=Africa/Accra
DJANGO_SECURE_SSL_REDIRECT=false

# API / worker
CAPTURED_FACES_DIR=private_uploads
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=16000000
RATE_LIMIT_PER_MINUTE=30
JOB_TIMEOUT_SECONDS=300
ENABLE_DEV_IMAGE_ENDPOINT=false
ENABLE_FACE_IDENTIFICATION=false
MATCH_THRESHOLD=0.45
EMBEDDING_MODEL=ArcFace
DELETE_RAW_IMAGE_AFTER_PROCESSING=true

# Desktop client (set DEVICE_API_KEY after create_device_key)
INGESTION_API_URL=http://localhost:8001/v1/snapshots
DEVICE_API_KEY=
MIN_SECONDS_BETWEEN_UPLOADS=10
